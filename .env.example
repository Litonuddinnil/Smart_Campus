# Copy this file to .env and fill in real values for LOCAL development.
# Never commit the real .env file (it is already in .gitignore).
#
# On Hugging Face Spaces, set these as Space "Secrets" / "Variables" instead
# of committing a .env file -- see README.md's deployment section.

# --- LLM provider ------------------------------------------------------
# Which API to call for operator-note interpretation. Free-tier-friendly
# options first; all use the OpenAI-compatible chat-completions format
# except "anthropic". See gridwise/config.py PROVIDER_PRESETS for the full
# list and each provider's default base URL / model.
#
#   groq         - free tier, fast, Llama 3.3 70B          (recommended default)
#   gemini       - free tier via Google AI Studio
#   huggingface  - HF Inference Providers (natural fit when hosting on HF)
#   cerebras     - free tier, very fast
#   openrouter   - free-tier models available
#   openai       - paid
#   anthropic    - paid
#   ollama       - self-hosted / local model, no key needed
#   custom       - any other OpenAI-compatible endpoint (set LLM_BASE_URL)
LLM_PROVIDER=groq

# API key for the selected provider. You may also set the provider's own
# conventional env var name instead (e.g. GROQ_API_KEY, HF_TOKEN,
# GEMINI_API_KEY) -- LLM_API_KEY is just the provider-agnostic name.
LLM_API_KEY=REPLACE-ME

# Model id. Leave blank to use the built-in default for the selected
# provider (see PROVIDER_PRESETS in gridwise/config.py).
LLM_MODEL=

# Only needed when LLM_PROVIDER=custom: the base URL of an OpenAI-compatible
# endpoint, e.g. http://localhost:8080/v1 for a self-hosted server.
LLM_BASE_URL=

# Seconds to wait for the model before retrying/failing safe. The whole
# POST /optimize-energy request must finish within 30s (judge rule).
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024

# Cache identical (notes, battery-capacity, model) interpretations in memory.
# Cuts latency/quota use for repeated hidden-test replays; safe because the
# mapping is deterministic given the same inputs and model.
LLM_CACHE_ENABLED=true
LLM_CACHE_SIZE=512

# --- Server --------------------------------------------------------------
# 7860 is the Hugging Face Spaces default container port.
HOST=0.0.0.0
PORT=7860
DEBUG=false
LOG_LEVEL=INFO
